# Variable reference only. RecoveryBox does not load this file automatically.
# If shell or secret tooling creates a local .env, never commit it.
OPENAI_API_KEY=

# The prototype intentionally pins the requested Realtime model.
RECOVERYBOX_REALTIME_MODEL=gpt-realtime-2.1
RECOVERYBOX_REALTIME_VOICE=marin

# Signed 16-bit little-endian, mono PCM is used in both directions.
RECOVERYBOX_AUDIO_RATE_HZ=24000
RECOVERYBOX_CAPTURE_DEVICE=default
RECOVERYBOX_PLAYBACK_DEVICE=default

# Laptop squat demo. The model is installed only by the explicit setup command.
RECOVERYBOX_CAMERA_INDEX=0
RECOVERYBOX_POSE_MODEL_PATH=models/mediapipe/pose_landmarker_lite-v1.task
RECOVERYBOX_CAMERA_PREVIEW=true

# Configure these for the selected Raspberry Pi carrier/HAT.
RECOVERYBOX_BUTTON_GPIO=23
RECOVERYBOX_LED_GPIO=25
RECOVERYBOX_MIN_HOLD_MS=180

# Local-only sanitized training data. Raw media must never be written here.
RECOVERYBOX_FEATURE_STORE=data/features.jsonl
RECOVERYBOX_TRANSCRIPT_RETENTION=false
